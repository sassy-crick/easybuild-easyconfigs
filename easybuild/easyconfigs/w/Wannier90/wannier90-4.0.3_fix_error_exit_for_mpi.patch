   if (ierr /= 0) then
     write (stderr, *) 'Wannier90: failed to deallocate u_matrix_opt!'
-    stop 1
+    goto 1000
   end if
 
   call print_times(common_data, stdout)
@@ -375,6 +369,16 @@ program wannier
     close (unit=stdout)
   end if
 
+  goto 2000
+
+1000 continue
+#ifdef W90_MPI
+  call mpi_abort(mpi_comm_world, ierr, ierr)
+#else
+  stop 1
+#endif
+
+2000 continue
 #ifdef W90_MPI
   call mpi_finalize(ierr)
 #endif
